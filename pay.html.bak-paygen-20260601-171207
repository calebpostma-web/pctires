<script src="https://js.stripe.com/v3/"></script>

<style>
:root {
  --black:#0a0a0a; --dark:#121212; --card:#161616; --raised:#1d1d1d;
  --border:#252525; --mid:#2d2d2d; --muted:#888;
  --light:#cfcfcf; --white:#f4f4f4;
  --yellow:#f5c518; --yellow-dim:rgba(245,197,24,0.1); --yellow-dark:#dba900;
  --green:#16a34a; --red:#dc2626;
}
* { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; }
body { background:var(--black); color:var(--white); font-family:'Barlow',sans-serif; font-size:15px; line-height:1.6; overflow-x:hidden; min-height:100vh; }

.site-header { background:rgba(10,10,10,.96); border-bottom:1px solid var(--border); padding:14px 32px; display:flex; align-items:center; justify-content:space-between; }
.logo { font-family:'Barlow Condensed',sans-serif; font-size:24px; font-weight:900; letter-spacing:3px; text-transform:uppercase; color:var(--white); text-decoration:none; }
.logo .pc { color:var(--yellow); }
.nav-phone { font-family:'IBM Plex Mono',monospace; font-size:14px; background:var(--yellow); color:var(--black); padding:9px 16px; border-radius:2px; font-weight:700; text-decoration:none; }

.wrap { max-width:580px; margin:0 auto; padding:48px 24px 80px; }

h1 { font-family:'Barlow Condensed',sans-serif; font-size:clamp(32px,5vw,44px); font-weight:900; color:var(--white); text-align:center; margin-bottom:8px; letter-spacing:-.3px; }
h1 .accent { color:var(--yellow); }
.subline { text-align:center; color:var(--muted); margin-bottom:32px; font-size:15px; }

.invoice-card {
  background:var(--card); border:1px solid var(--border); border-top:3px solid var(--yellow);
  border-radius:2px; padding:24px 26px; margin-bottom:22px;
}
.amount-display {
  text-align:center; padding:14px 0 18px; border-bottom:1px solid var(--border); margin-bottom:18px;
}
.amount-label { font-size:11px; text-transform:uppercase; letter-spacing:1.5px; color:var(--muted); font-weight:700; margin-bottom:6px; }
.amount-value { font-family:'Barlow Condensed',sans-serif; font-size:46px; font-weight:900; color:var(--yellow); line-height:1; }
.amount-value .cur { font-size:18px; color:var(--muted); font-weight:600; letter-spacing:1px; margin-left:6px; }

.invoice-row { display:flex; justify-content:space-between; padding:9px 0; font-size:14px; }
.invoice-row + .invoice-row { border-top:1px solid var(--border); }
.invoice-row .label { color:var(--muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.8px; }
.invoice-row .value { color:var(--white); font-weight:500; text-align:right; max-width:60%; }

.form-card {
  background:var(--card); border:1px solid var(--border); border-radius:2px; padding:24px 26px;
}
.form-section-head { font-family:'Barlow Condensed',sans-serif; font-size:18px; font-weight:700; color:var(--white); margin-bottom:14px; }

.fg { display:flex; flex-direction:column; gap:6px; margin-bottom:14px; }
.fg label { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); }
.fg input, .fg textarea {
  background:var(--raised); color:var(--white); border:1px solid var(--border); border-radius:2px; padding:12px 14px;
  font-family:'Barlow',sans-serif; font-size:15px; transition:border-color .15s;
}
.fg input:focus, .fg textarea:focus { outline:0; border-color:var(--yellow); }
.fg input[readonly] { background:var(--dark); color:var(--muted); cursor:default; }
.fg .helper { font-size:12px; color:var(--muted); margin-top:3px; }
.amount-input-wrap { position:relative; }
.amount-input-wrap::before {
  content:'$'; position:absolute; left:14px; top:50%; transform:translateY(-50%);
  color:var(--muted); font-weight:600; font-size:15px; pointer-events:none;
}
.amount-input-wrap input { padding-left:28px; }

.form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media(max-width:600px) { .form-row { grid-template-columns:1fr; gap:0; } }

#stripeElements { background:var(--raised); border:1px solid var(--border); border-radius:2px; padding:14px; }
#stripeError { color:var(--red); font-size:13px; margin-top:6px; display:none; }

.pay-btn {
  width:100%; background:var(--yellow); color:var(--black); padding:17px;
  border:0; border-radius:2px; font-family:'Barlow',sans-serif;
  font-size:15px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;
  cursor:pointer; transition:background .15s; margin-top:18px;
}
.pay-btn:hover:not(:disabled) { background:var(--yellow-dark); }
.pay-btn:disabled { opacity:.6; cursor:wait; }

.form-error {
  background:rgba(220,38,38,.1); border:1px solid var(--red); color:var(--red);
  padding:11px 14px; border-radius:2px; font-size:13px; margin-top:12px; display:none;
}
.form-error.show { display:block; }

.secure-row { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:14px; font-size:12px; color:var(--muted); }
.secure-row .lock { color:var(--green); }

/* SUCCESS STATE */
.success-state { display:none; text-align:center; padding:40px 16px; }
.success-state.show { display:block; }
.success-circle {
  width:90px; height:90px; border-radius:50%; background:var(--yellow); color:var(--black);
  display:flex; align-items:center; justify-content:center; font-size:48px; font-weight:900;
  margin:0 auto 24px; box-shadow:0 0 0 8px rgba(245,197,24,.15);
}
.success-title { font-family:'Barlow Condensed',sans-serif; font-size:32px; font-weight:900; margin-bottom:10px; color:var(--white); }
.success-amount { font-family:'Barlow Condensed',sans-serif; font-size:42px; font-weight:900; color:var(--yellow); margin:12px 0; line-height:1; }
.success-sub { color:var(--light); font-size:15px; line-height:1.6; max-width:400px; margin:0 auto; }
.success-sub strong { color:var(--white); }
.success-meta { background:var(--raised); border:1px solid var(--border); border-radius:2px; padding:14px 18px; margin:22px auto; max-width:380px; font-size:13px; text-align:left; }
.success-meta .meta-row { display:flex; justify-content:space-between; padding:5px 0; }
.success-meta .meta-row .lbl { color:var(--muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.6px; }
.success-meta .meta-row .val { color:var(--white); font-family:'IBM Plex Mono',monospace; font-size:12px; }

footer { padding:30px 24px; text-align:center; color:var(--muted); font-size:12px; border-top:1px solid var(--border); }
footer a { color:var(--muted); text-decoration:none; }
footer a:hover { color:var(--yellow); }
</style>
</head>
<body>

<header class="site-header">
  <a href="/" class="logo"><span class="pc">PC</span>TIRES</a>
  <a href="tel:5193974686" class="nav-phone">519-397-4686</a>
</header>

<div class="wrap">

  <!-- BEFORE PAY: form view -->
  <div id="payForm">

    <h1>Pay Your <span class="accent">Invoice</span></h1>
    <p class="subline">Secure card payment via Stripe. Receipt sent by email.</p>

    <div class="invoice-card" id="invoiceCard">
      <div class="amount-display" id="amountDisplay" style="display:none">
        <div class="amount-label">Amount Due</div>
        <div class="amount-value"><span id="displayAmount">0.00</span><span class="cur">CAD</span></div>
      </div>
      <div id="invoiceMetaRows"></div>
    </div>

    <div class="form-card">
      <div class="form-section-head">Payment Details</div>

      <!-- Amount field (always present, may be readonly if URL provided amount) -->
      <div class="fg" id="amountFieldWrap">
        <label for="payAmount">Amount (CAD)</label>
        <div class="amount-input-wrap">
          <input type="number" id="payAmount" step="0.01" min="0.50" max="5000" placeholder="0.00" oninput="onAmountChange()">
        </div>
        <div class="helper" id="amountHelper">Enter the amount you were quoted by PC Tires.</div>
      </div>

      <!-- Description field (only shown when not pre-filled in URL) -->
      <div class="fg" id="descFieldWrap" style="display:none">
        <label for="payDesc">What is this for?</label>
        <input type="text" id="payDesc" placeholder="e.g. Flat Repair, Mar 12">
      </div>

      <div class="form-row">
        <div class="fg"><label>Your Name *</label><input type="text" id="payName" placeholder="Jane Smith"></div>
        <div class="fg"><label>Phone</label><input type="tel" id="payPhone" placeholder="(519) 000-0000"></div>
      </div>
      <div class="fg"><label>Email * (for receipt)</label><input type="email" id="payEmail" placeholder="jane@example.com"></div>

      <div class="form-section-head" style="margin-top:18px">Card</div>
      <div class="fg">
        <label>Card Number, Expiry, CVC</label>
        <div id="stripeElements"></div>
        <div id="stripeError"></div>
      </div>

      <div class="form-error" id="formError"></div>

      <button class="pay-btn" id="payBtn" onclick="processPayment()">Pay Securely</button>

      <div class="secure-row">
        <span class="lock">&#x1F512;</span>
        <span>Encrypted &middot; PCI-compliant &middot; Stripe</span>
      </div>
    </div>

  </div>

  <!-- AFTER PAY: success view -->
  <div class="success-state" id="paySuccess">
    <div class="success-circle">&check;</div>
    <div class="success-title">Payment Received!</div>
    <div class="success-amount">$<span id="paidAmount">—</span></div>
    <p class="success-sub">
      Thank you, <strong id="paidName">customer</strong>.<br>
      A receipt has been sent to <strong id="paidEmail">your email</strong>.
    </p>
    <div class="success-meta">
      <div class="meta-row"><span class="lbl">Reference</span><span class="val" id="paidRef">—</span></div>
      <div class="meta-row" id="paidDescRow" style="display:none"><span class="lbl">For</span><span class="val" id="paidDesc">—</span></div>
      <div class="meta-row"><span class="lbl">Payment ID</span><span class="val" id="paidPiId">—</span></div>
    </div>
    <p style="margin-top:24px;font-size:14px;color:var(--muted)">
      Questions? Call us at <a href="tel:5193974686" style="color:var(--yellow);text-decoration:none">519-397-4686</a>
    </p>
  </div>

</div>

<footer>
  PC Tires &middot; 7144 Grande River Line, Pain Court, ON N0P 1Z0<br>
  <a href="tel:5193974686">519-397-4686</a> &middot; <a href="/">pctires.ca</a>
</footer>

<script>
// ─────────────────────────────────────────────────────────────────
// READ URL PARAMS + RENDER
// ?amount=30&desc=Flat+Repair&invoice=INV-042&name=Bob&email=bob@x.com
// ─────────────────────────────────────────────────────────────────
function urlParam(name) {
  try { return (new URL(window.location.href)).searchParams.get(name) || ''; }
  catch(e) { return ''; }
}

const initial = {
  amount:  parseFloat(urlParam('amount')) || null,
  desc:    urlParam('desc'),
  invoice: urlParam('invoice'),
  name:    urlParam('name'),
  email:   urlParam('email'),
};

// Stripe public key (live)
const STRIPE_PK = 'pk_live_51T86uxRufNpmOxQPt6KAjj4Yb8UOOpJqJAQ2KIae2d9adLFF9Ty8hS4T38GHaGHCOfsFVzBEHWKVGCl2Jq99N5Np00oylz5jPV';

let stripe = null, elements = null, cardEl = null;

function renderInvoiceCard() {
  // Pre-fill amount from URL if present
  if (initial.amount && initial.amount > 0) {
    document.getElementById('payAmount').value = initial.amount.toFixed(2);
    document.getElementById('payAmount').readOnly = true;
    document.getElementById('amountHelper').textContent = 'Locked to the amount on your invoice. Call us if this is incorrect.';
    document.getElementById('amountDisplay').style.display = 'block';
    document.getElementById('displayAmount').textContent = initial.amount.toFixed(2);
  }
  // Description: if URL provided, lock and show in invoice card; else show editable input
  const meta = document.getElementById('invoiceMetaRows');
  let rows = '';
  if (initial.invoice) rows += `<div class="invoice-row"><span class="label">Invoice #</span><span class="value">${escapeHtml(initial.invoice)}</span></div>`;
  if (initial.desc)    rows += `<div class="invoice-row"><span class="label">For</span><span class="value">${escapeHtml(initial.desc)}</span></div>`;
  meta.innerHTML = rows;
  if (!initial.desc) {
    document.getElementById('descFieldWrap').style.display = 'block';
  }
  // Hide the empty invoice card if nothing to show
  if (!initial.amount && !initial.invoice && !initial.desc) {
    document.getElementById('invoiceCard').style.display = 'none';
  }
  // Pre-fill customer fields
  if (initial.name)  document.getElementById('payName').value = initial.name;
  if (initial.email) document.getElementById('payEmail').value = initial.email;
}

function onAmountChange() {
  const v = parseFloat(document.getElementById('payAmount').value);
  if (!isNaN(v) && v > 0) {
    document.getElementById('displayAmount').textContent = v.toFixed(2);
    document.getElementById('amountDisplay').style.display = 'block';
  }
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ─────────────────────────────────────────────────────────────────
// STRIPE ELEMENTS INIT
// ─────────────────────────────────────────────────────────────────
function initStripe() {
  if (typeof Stripe === 'undefined') {
    setTimeout(initStripe, 200);
    return;
  }
  stripe = Stripe(STRIPE_PK);
  const appearance = {
    theme: 'night',
    variables: {
      colorPrimary: '#f5c518', colorBackground: '#1d1d1d',
      colorText: '#f4f4f4', colorDanger: '#dc2626',
      fontFamily: 'Barlow, sans-serif', borderRadius: '2px',
    },
  };
  elements = stripe.elements({ appearance });
  cardEl = elements.create('card', {
    style: { base: { color: '#f4f4f4', fontFamily: 'Barlow, sans-serif', fontSize: '15px', '::placeholder': { color: '#888' } } }
  });
  cardEl.mount('#stripeElements');
  cardEl.on('change', function(e) {
    const errEl = document.getElementById('stripeError');
    if (errEl) { errEl.textContent = e.error ? e.error.message : ''; errEl.style.display = e.error ? 'block' : 'none'; }
  });
}

// ─────────────────────────────────────────────────────────────────
// PROCESS PAYMENT
// ─────────────────────────────────────────────────────────────────
async function processPayment() {
  const errEl = document.getElementById('formError');
  errEl.classList.remove('show');

  const amount = parseFloat(document.getElementById('payAmount').value);
  const desc   = (initial.desc || document.getElementById('payDesc')?.value || '').trim();
  const name   = document.getElementById('payName').value.trim();
  const phone  = document.getElementById('payPhone').value.trim();
  const email  = document.getElementById('payEmail').value.trim();

  // Validation
  if (isNaN(amount) || amount < 0.50)  return showErr('Enter an amount of at least $0.50.');
  if (amount > 5000)                   return showErr('Amounts over $5000 — please call the shop at 519-397-4686.');
  if (!name)                           return showErr('Please enter your name.');
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showErr('Please enter a valid email address.');
  if (!stripe || !cardEl)              return showErr('Payment form not ready. Reload the page and try again.');

  const btn = document.getElementById('payBtn');
  btn.textContent = 'Processing…'; btn.disabled = true;

  // Reference number for this payment (prefix INV to distinguish from tire orders PCT)
  const reference = initial.invoice || ('INV-' + Date.now().toString(36).toUpperCase().slice(-7));
  const amountCents = Math.round(amount * 100);

  try {
    // 1) Create PaymentIntent
    const piRes = await fetch('/create-pi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amountCents, orderNumber: reference, customerEmail: email }),
    });
    const piData = await piRes.json();
    if (piData.error) throw new Error(piData.error);
    if (!piData.clientSecret) throw new Error('Server did not return a payment session.');

    // 2) Confirm payment with card
    const result = await stripe.confirmCardPayment(piData.clientSecret, {
      payment_method: { card: cardEl, billing_details: { name, email, phone } },
            receipt_email: email,
    });
    if (result.error) throw new Error(result.error.message);
    if (result.paymentIntent.status !== 'succeeded') throw new Error('Payment did not complete. Try again or call the shop.');

    const piId = result.paymentIntent.id;

    // 3) Notify Caleb via email
    try {
      await fetch('/send-payment-notification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          invoiceNumber:   reference,
          description:     desc,
          amount:          amount,
          currency:        'CAD',
          customerName:    name,
          customerEmail:   email,
          customerPhone:   phone,
          paymentIntentId: piId,
          notes:           '',
        }),
      });
    } catch(e) { console.warn('Notification email failed:', e.message); }

    // 4) Show success
    document.getElementById('paidAmount').textContent = amount.toFixed(2);
    document.getElementById('paidName').textContent = name.split(' ')[0] || name;
    document.getElementById('paidEmail').textContent = email;
    document.getElementById('paidRef').textContent = reference;
    document.getElementById('paidPiId').textContent = piId;
    if (desc) {
      document.getElementById('paidDesc').textContent = desc;
      document.getElementById('paidDescRow').style.display = 'flex';
    }
    document.getElementById('payForm').style.display = 'none';
    document.getElementById('paySuccess').classList.add('show');
    window.scrollTo({ top: 0, behavior:'smooth' });

  } catch (e) {
    showErr(e.message || 'Payment failed. Please try again or call us at 519-397-4686.');
    btn.textContent = 'Pay Securely';
    btn.disabled = false;
  }
}

function showErr(msg) {
  const el = document.getElementById('formError');
  el.textContent = msg;
  el.classList.add('show');
  window.scrollTo({ top: el.offsetTop - 200, behavior:'smooth' });
}

// ─────────────────────────────────────────────────────────────────
// INIT
// ─────────────────────────────────────────────────────────────────
renderInvoiceCard();
initStripe();
</script>

</body>
</html>
