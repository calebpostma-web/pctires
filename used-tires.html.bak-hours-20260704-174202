<script>
// ───────── CONFIG / STATE ─────────
var API = '/used-tires';
var ALL = [];          // public list (available)
var ADMIN_ALL = [];    // owner list (incl sold)
var TYPE = 'all';
var PW = '';           // owner password held in memory for this session
var editId = null;
var quoteProduct = null;

// ───────── PUBLIC LIST ─────────
function loadPublic() {
  fetch(API)
    .then(function(r){ return r.json(); })
    .then(function(d){ ALL = (d && d.tires) ? d.tires : []; applyFilters(); })
    .catch(function(){ ALL = []; applyFilters(); });
}

function applyFilters() {
  var q = document.getElementById('fSearch').value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');
  var sort = document.getElementById('fSort').value;
  var list = ALL.filter(function(t){
    if (TYPE !== 'all' && t.type !== TYPE) return false;
    if (q) {
      var hay = ((t.size||'') + (t.brand||'') + (t.notes||'')).toUpperCase().replace(/[^A-Z0-9]/g,'');
      if (hay.indexOf(q) === -1) return false;
    }
    return true;
  });
  list.sort(function(a,b){
    if (sort === 'newest') return (b.addedAt||0) - (a.addedAt||0);
    var pa = a.price > 0 ? a.price : 9e9, pb = b.price > 0 ? b.price : 9e9;
    return sort === 'price-desc' ? pb - pa : pa - pb;
  });
  renderGrid(list);
}

function renderGrid(list) {
  var grid = document.getElementById('grid');
  grid.innerHTML = '';
  list.forEach(function(t){ grid.appendChild(card(t)); });
  document.getElementById('resultNote').textContent = list.length ? ('Showing ' + list.length + (list.length === 1 ? ' tire' : ' tires')) : '';
  document.getElementById('emptyMsg').style.display = list.length ? 'none' : 'block';
}

function card(t) {
  var price = fmtPrice(t.price);
  var el = document.createElement('div');
  el.className = 'tcard';
  var meta = [];
  if (t.brand && t.model) meta.push(esc(t.model));
  if (t.tread) meta.push('Tread ' + esc(t.tread));
  if (t.season) meta.push(esc(t.season));
  if (t.notes) meta.push(esc(t.notes));
  el.innerHTML =
    '<div class="toprow"><span class="size">' + esc(t.size || '—') + '</span>' +
      '<span class="tag ' + (t.type === 'new' ? 'new' : 'used') + '">' + (t.type === 'new' ? 'Budget New' : 'Used') + '</span></div>' +
    '<div class="brand">' + esc(t.brand || 'Tire') + '</div>' +
    '<div class="meta">' + (meta.length ? meta.join(' · ') : '&nbsp;') + '</div>' +
    (price ? '<div class="price">$' + price + ' <span class="ea">/ tire</span></div>'
           : '<div class="price" style="font-size:20px">Call for Price</div>') +
    '<div class="qtytag">' + (t.qty > 1 ? (t.qty + ' available') : '&nbsp;') + '</div>' +
    '<div class="actions">' +
      '<a class="act-call" href="tel:519-397-4686">Call to Order</a>' +
      '<button class="act-quote">Hold It</button>' +
    '</div>';
  el.querySelector('.act-quote').addEventListener('click', function(){ openQuote(t); });
  return el;
}

function fmtPrice(p) {
  if (!p || p <= 0) return null;
  return p.toLocaleString('en-CA', { minimumFractionDigits: (p % 1 === 0 ? 0 : 2), maximumFractionDigits: 2 });
}
function esc(s) {
  return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; });
}

// chips + filter events
document.getElementById('typeChips').addEventListener('click', function(e){
  var chip = e.target.closest('.chip'); if (!chip) return;
  document.querySelectorAll('#typeChips .chip').forEach(function(c){ c.classList.remove('active'); });
  chip.classList.add('active');
  TYPE = chip.getAttribute('data-type');
  applyFilters();
});
document.getElementById('fSearch').addEventListener('input', applyFilters);
document.getElementById('fSort').addEventListener('change', applyFilters);

// ───────── QUOTE / HOLD ─────────
function openQuote(t) {
  quoteProduct = t;
  var label = (t.size || '') + ' ' + (t.brand || '') + (t.price > 0 ? ' — $' + fmtPrice(t.price) + '/tire' : '');
  document.getElementById('mProduct').textContent = label;
  document.getElementById('quoteForm').style.display = 'block';
  document.getElementById('quoteSuccess').classList.remove('show');
  document.getElementById('qError').classList.remove('show');
  document.getElementById('quoteModal').classList.add('show');
}
function closeQuote() { document.getElementById('quoteModal').classList.remove('show'); }
document.getElementById('quoteModal').addEventListener('click', function(e){ if (e.target === e.currentTarget) closeQuote(); });

async function submitQuote() {
  var name = document.getElementById('qName').value.trim();
  var phone = document.getElementById('qPhone').value.trim();
  var notes = document.getElementById('qNotes').value.trim();
  var err = document.getElementById('qError');
  err.classList.remove('show');
  if (!name) { err.textContent = 'Please enter your name.'; err.classList.add('show'); return; }
  if (!phone) { err.textContent = 'Please enter a phone number so we can call you back.'; err.classList.add('show'); return; }
  var btn = document.getElementById('qSubmit');
  btn.textContent = 'Sending…'; btn.disabled = true;
  var t = quoteProduct || {};
  var price = t.price > 0 ? '$' + fmtPrice(t.price) + '/tire' : 'call for price';
  var payload = {
    service: 'Used/Budget Tire Hold Request',
    customerName: name, customerPhone: phone, customerEmail: '', vehicle: '',
    notes: 'TIRE: ' + (t.size || '?') + ' ' + (t.brand || '') + ' [' + (t.type || 'used') + ']' +
           ' | PRICE: ' + price + ' | QTY AVAIL: ' + (t.qty || '?') +
           (t.tread ? ' | TREAD: ' + t.tread : '') + (notes ? ' | NOTES: ' + notes : ''),
    preferredDate: 'Hold request — call back', preferredTime: '', duration: 0, price: price,
  };
  try {
    await fetch('/send-service-request', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
  } catch (e) {}
  btn.textContent = 'Send Request'; btn.disabled = false;
  document.getElementById('quoteForm').style.display = 'none';
  document.getElementById('quoteSuccess').classList.add('show');
}

// ───────── OWNER ADMIN ─────────
document.getElementById('ownerLink').addEventListener('click', function(){
  document.getElementById('admErr').classList.remove('show');
  document.getElementById('admFormErr').classList.remove('show');
  var saved = sessionStorage.getItem('pcUsedPw');
  if (saved) { PW = saved; openAdminPanel(); }
  else { document.getElementById('admLogin').style.display = 'block'; document.getElementById('admPanel').style.display = 'none'; }
  document.getElementById('adminModal').classList.add('show');
});
function closeAdmin() { document.getElementById('adminModal').classList.remove('show'); }

async function api(action, extra) {
  var body = Object.assign({ action: action, password: PW }, extra || {});
  var r = await fetch(API, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  return r.json();
}

async function admUnlock() {
  var pw = document.getElementById('admPw').value;
  var err = document.getElementById('admErr');
  err.classList.remove('show');
  if (!pw) { err.textContent = 'Enter the password.'; err.classList.add('show'); return; }
  PW = pw;
  var res = await api('verify');
  if (res && res.ok) {
    sessionStorage.setItem('pcUsedPw', PW);
    openAdminPanel();
  } else {
    PW = '';
    err.textContent = (res && res.error) ? res.error : 'Incorrect password.';
    err.classList.add('show');
  }
}

async function openAdminPanel() {
  document.getElementById('admLogin').style.display = 'none';
  document.getElementById('admPanel').style.display = 'block';
  admResetForm();
  await admRefreshList();
}

async function admRefreshList() {
  var res = await api('list');
  if (res && res.ok) { ADMIN_ALL = res.tires || []; renderAdminList(); }
  else if (res && res.error) { showAdmFormErr(res.error); }
}

function renderAdminList() {
  var wrap = document.getElementById('admList');
  wrap.innerHTML = '';
  if (!ADMIN_ALL.length) { wrap.innerHTML = '<div class="adm-note" style="padding:14px 0">No tires yet. Add your first one above.</div>'; return; }
  ADMIN_ALL.forEach(function(t){
    var row = document.createElement('div');
    row.className = 'adm-row' + (t.status === 'sold' ? ' sold' : '');
    var sub = [t.type === 'new' ? 'Budget New' : 'Used', t.brand || ''];
    if (t.qty > 1) sub.push(t.qty + ' avail');
    if (t.tread) sub.push('tread ' + t.tread);
    if (t.status === 'sold') sub.push('SOLD');
    row.innerHTML =
      '<div class="ainfo"><span class="asize">' + esc(t.size || '—') + '</span> ' +
        (t.price > 0 ? '$' + fmtPrice(t.price) : 'call') +
        '<div class="asub">' + esc(sub.filter(Boolean).join(' · ')) + '</div></div>';
    var btns = document.createElement('div');
    btns.className = 'abtns';
    btns.appendChild(mkBtn('Edit', function(){ admEdit(t.id); }));
    if (t.status === 'sold') btns.appendChild(mkBtn('Relist', function(){ admAction('relist', t.id); }));
    else btns.appendChild(mkBtn('Sold', function(){ admAction('sold', t.id); }));
    var del = mkBtn('Delete', function(){ if (confirm('Delete this tire for good?')) admAction('delete', t.id); });
    del.className = 'del';
    btns.appendChild(del);
    row.appendChild(btns);
    wrap.appendChild(row);
  });
}
function mkBtn(label, fn) { var b = document.createElement('button'); b.textContent = label; b.addEventListener('click', fn); return b; }

function admValForm() {
  var price = parseFloat(document.getElementById('aPrice').value);
  return {
    type: document.getElementById('aType').value,
    size: document.getElementById('aSize').value.trim(),
    brand: document.getElementById('aBrand').value.trim(),
    price: isFinite(price) ? price : null,
    qty: parseInt(document.getElementById('aQty').value, 10) || 1,
    tread: document.getElementById('aTread').value.trim(),
    notes: document.getElementById('aNotes').value.trim(),
  };
}

async function admSave() {
  var err = document.getElementById('admFormErr');
  err.classList.remove('show');
  var t = admValForm();
  if (!t.size) { showAdmFormErr('Size is required.'); return; }
  if (!t.brand) { showAdmFormErr('Brand is required.'); return; }
  var btn = document.getElementById('aSaveBtn');
  var orig = btn.textContent; btn.textContent = 'Saving…'; btn.disabled = true;
  var res = editId ? await api('update', { id: editId, tire: t }) : await api('add', { tire: t });
  btn.textContent = orig; btn.disabled = false;
  if (res && res.ok) {
    ADMIN_ALL = res.tires || [];
    renderAdminList();
    admResetForm();
    loadPublic();
  } else {
    showAdmFormErr((res && res.error) ? res.error : 'Save failed.');
  }
}

function admEdit(id) {
  var t = ADMIN_ALL.filter(function(x){ return x.id === id; })[0];
  if (!t) return;
  editId = id;
  document.getElementById('aType').value = t.type === 'new' ? 'new' : 'used';
  document.getElementById('aSize').value = t.size || '';
  document.getElementById('aBrand').value = t.brand || '';
  document.getElementById('aPrice').value = (t.price != null ? t.price : '');
  document.getElementById('aQty').value = t.qty || 1;
  document.getElementById('aTread').value = t.tread || '';
  document.getElementById('aNotes').value = t.notes || '';
  document.getElementById('admFormTitle').textContent = 'Edit Tire';
  document.getElementById('aSaveBtn').textContent = 'Save Changes';
  document.getElementById('adminModal').scrollTop = 0;
}

function admResetForm() {
  editId = null;
  ['aSize','aBrand','aPrice','aQty','aTread','aNotes'].forEach(function(id){ document.getElementById(id).value = ''; });
  document.getElementById('aType').value = 'used';
  document.getElementById('admFormTitle').textContent = 'Add a Tire';
  document.getElementById('aSaveBtn').textContent = 'Add Tire';
}

async function admAction(action, id) {
  var res = await api(action, { id: id });
  if (res && res.ok) { ADMIN_ALL = res.tires || []; renderAdminList(); loadPublic(); }
  else { showAdmFormErr((res && res.error) ? res.error : 'Action failed.'); }
}

function showAdmFormErr(msg) {
  var err = document.getElementById('admFormErr');
  err.textContent = msg; err.classList.add('show');
}

document.getElementById('adminModal').addEventListener('click', function(e){ if (e.target === e.currentTarget) closeAdmin(); });

// ───────── INIT ─────────
loadPublic();
</script>

</body>
